# One SUSE AI component per data point of the suse_ai_declared_component
# gauge. Applications send it to their OpenTelemetry collector (see
# charts/hr-assistant-vllm templates/topology.yaml) instead of waiting for the
# SUSE AI collector to infer the component from live spans.
#
# The identifier is the one the SUSE AI and OpenTelemetry StackPacks give the
# same component, so a declared component and the one they create from live
# telemetry are one node. Their sync wins name, type, layer and domain; this
# mapping adds tags and keeps the component (and the relations below) alive
# while there is no traffic. Chosen by the data point's attributes:
#
# - `instance` (with a k8s.namespace.name resource attribute):
#   urn:suse-ai:urn:opentelemetry:namespace/<ns>:service/<name>:serviceInstance/<instance>
# - `namespace` (the service.namespace the component reports):
#   urn:opentelemetry:namespace/<namespace>:service/<name>, the OpenTelemetry
#   service of an application, inference engine or database that reports or is
#   seen in traces. Its type is `otel service`, like theirs.
# - neither: urn:suse-ai:product:<type>:<name>, which one name shares across
#   namespaces.
nodes:
  - _type: "OtelComponentMapping"
    name: "Declared SUSE AI component"
    description: "Creates a SUSE AI component an application declares up front"
    identifier: "urn:stackpack:suse-ai-declared-topology:shared:otel-component-mapping:declared-component"
    input:
      signal:
        - "METRICS"
      resource:
        condition: "'suse.ai.topology.declared' in resource.attributes"
        scope:
          condition: "scope.name == 'suse-ai-declared-topology'"
          metric:
            condition: "metric.name == 'suse_ai_declared_component'"
            datapoint:
              condition: "'type' in datapoint.attributes && 'name' in datapoint.attributes"
              action: "'CREATE'"
    vars:
      - name: "type"
        value: "datapoint.attributes['type']"
      - name: "name"
        value: "datapoint.attributes['name']"
      # `otel service` for the namespace form, like the component the
      # OpenTelemetry StackPack creates; else the SUSE AI StackPack component
      # type, e.g. inference-engine.vllm, which carries the product's metric
      # bindings and monitors. The id checks instance, then namespace (above).
      - name: "typeName"
        value: >-
          !('instance' in datapoint.attributes && 'k8s.namespace.name' in resource.attributes) && ('namespace' in datapoint.attributes && datapoint.attributes['namespace'] != '') ? 'otel service' :
          'type_name' in datapoint.attributes && datapoint.attributes['type_name'] != '' ?
          datapoint.attributes['type_name'] :
          datapoint.attributes['type']
      - name: "id"
        value: >-
          ('instance' in datapoint.attributes && 'k8s.namespace.name' in resource.attributes) ?
          'urn:suse-ai:urn:opentelemetry:namespace/' + resource.attributes['k8s.namespace.name'] +
          ':service/' + datapoint.attributes['name'] + ':serviceInstance/' + datapoint.attributes['instance'] :
          ('namespace' in datapoint.attributes && datapoint.attributes['namespace'] != '') ?
          'urn:opentelemetry:namespace/' + datapoint.attributes['namespace'] + ':service/' + datapoint.attributes['name'] :
          'urn:suse-ai:product:' + datapoint.attributes['type'] + ':' + datapoint.attributes['name']
    output:
      identifier: "vars.id"
      name: "vars.name"
      typeName: "vars.typeName"
      required:
        tags:
          - source: "'suse-ai-declared-topology'"
            target: "stackpack"
          - source: "'declared'"
            target: "suse.ai.topology.source"
          - source: "vars.type"
            target: "suse.ai.component.type"
          # The SUSE AI views select on suse.ai.category, so a component
          # that is only declared (no traffic yet) still shows in them.
          - source: "vars.type"
            target: "suse.ai.category"
          - source: "'true'"
            target: "suse.ai.managed"
      optional:
        tags:
          # The SUSE AI views group services by product (vllm, qdrant, ...).
          - source: "datapoint.attributes['product']"
            target: "suse.ai.product"
          - source: "datapoint.attributes['namespace']"
            target: "service.namespace"
          - source: "resource.attributes['k8s.namespace.name']"
            target: "k8s.namespace.name"
          - source: "resource.attributes['k8s.cluster.name']"
            target: "k8s.cluster.name"
          - source: "resource.attributes['k8s.cluster.name']"
            target: "cluster-name"
    # Senders refresh every few minutes; an uninstalled application's
    # components go away 15 minutes after its last refresh.
    expireAfter: 900000
    rank:
      specificity: 250
