           - name: {{ .Release.Name }}-shared-pvc-storage
             mountPath: /data/shared-pvc-storage
           {{- end }}
@@ -444,7 +446,7 @@
         {{- end }}
         {{- toYaml $imagePullSecrets | nindent 8 }}
       {{- end }}
-      {{- if or (hasKey $modelSpec "pvcStorage") (and $modelSpec.vllmConfig (hasKey $modelSpec.vllmConfig "tensorParallelSize")) (hasKey $modelSpec "chatTemplate") (hasKey $modelSpec "extraVolumes") (hasKey $.Values "sharedPvcStorage") }}
+      {{- if or (hasKey $modelSpec "pvcStorage") (and $modelSpec.vllmConfig (hasKey $modelSpec.vllmConfig "tensorParallelSize")) (hasKey $modelSpec "chatTemplate") (hasKey $modelSpec "extraVolumes") (and (hasKey $.Values "sharedPvcStorage") (ternary true $.Values.sharedPvcStorage.enabled (not (hasKey $.Values.sharedPvcStorage "enabled")))) }}
       volumes:
       {{- end}}
         {{- if hasKey $modelSpec "pvcStorage" }}
@@ -457,7 +459,7 @@
             claimName: "{{ .Release.Name }}-{{$modelSpec.name}}-storage-claim"
         {{- end }}
         {{- end }}
-        {{- if hasKey $.Values "sharedPvcStorage" }}
+        {{- if and (hasKey $.Values "sharedPvcStorage") (ternary true $.Values.sharedPvcStorage.enabled (not (hasKey $.Values.sharedPvcStorage "enabled"))) }}
         - name: {{ .Release.Name }}-shared-pvc-storage
           persistentVolumeClaim:
             claimName: "{{ .Release.Name }}-shared-pvc-storage-claim"
