# Applied to SUSE's vllm chart by scripts/package-aif-charts.sh so install-form
# values and Fleet work:
#  - modelSpec.storageClass ""/"Default" omits storageClassName (cluster default class)
#  - sharedPvcStorage.enabled is honoured (upstream enables it whenever the key exists)
#  - HF_HOME points at the shared NFS cache when it is enabled (upstream mounts it
#    but keeps downloading into the per-install PVC)
#  - the engine/router Deployments' and Services' own metadata.labels say
#    app.kubernetes.io/managed-by: Helm. Upstream's "helm" is rewritten on the cluster,
#    so Fleet reported the bundle Modified. Selectors and pod labels keep "helm"
#    (selectors are immutable, so changing them would break upgrades).
#  - empty GPU-memory/core fields are ignored instead of rendered
--- a/templates/pvc.yaml
+++ b/templates/pvc.yaml
@@ -26,7 +26,7 @@
   resources:
     requests:
       storage: {{ $modelSpec.pvcStorage }}
-  {{- if hasKey $modelSpec "storageClass" }}
+  {{- if and (hasKey $modelSpec "storageClass") (not (empty $modelSpec.storageClass)) (ne $modelSpec.storageClass "Default") }}
   storageClassName: "{{ $modelSpec.storageClass }}"
   {{- end }}
   {{- if not (empty $modelSpec.pvcMatchLabels) }}
--- a/templates/shared-storage.yaml
+++ b/templates/shared-storage.yaml
@@ -1,4 +1,4 @@
-{{- if .Values.sharedPvcStorage }}
+{{- if and .Values.sharedPvcStorage (ternary true .Values.sharedPvcStorage.enabled (not (hasKey .Values.sharedPvcStorage "enabled"))) }}
 ---
 apiVersion: v1
 kind: PersistentVolume
@@ -9,7 +9,7 @@
     app: {{ .Release.Name }}
     component: shared-pvc-storage
 spec:
-  storageClassName: {{ .Values.sharedPvcStorage.storageClass | default "standard" }}
+  storageClassName: {{ if and .Values.sharedPvcStorage.storageClass (ne .Values.sharedPvcStorage.storageClass "Default") }}{{ .Values.sharedPvcStorage.storageClass }}{{ else }}""{{ end }}
   capacity:
     storage: {{ .Values.sharedPvcStorage.size | default "100Gi" }}
   accessModes:
@@ -36,7 +36,7 @@
     app: {{ .Release.Name }}
     component: shared-pvc-storage
 spec:
-  storageClassName: {{ .Values.sharedPvcStorage.storageClass | default "standard" }}
+  storageClassName: {{ if and .Values.sharedPvcStorage.storageClass (ne .Values.sharedPvcStorage.storageClass "Default") }}{{ .Values.sharedPvcStorage.storageClass }}{{ else }}""{{ end }}
   accessModes:
   {{- if .Values.sharedPvcStorage.accessModes }}
     {{- toYaml .Values.sharedPvcStorage.accessModes | nindent 4 }}
--- a/templates/deployment-vllm-multi.yaml
+++ b/templates/deployment-vllm-multi.yaml
@@ -22,7 +22,7 @@
   labels:
     model: {{ $modelSpec.name }}
     helm-release-name: {{ .Release.Name }}
-  {{- include "chart.engineStandardLabels" (dict "releaseName" .Release.Name "modelName" $modelSpec.name "chartName" .Chart.Name) | nindent 4 }}
+  {{- include "chart.engineStandardLabels" (dict "releaseName" .Release.Name "modelName" $modelSpec.name "chartName" .Chart.Name) | replace "managed-by: helm" "managed-by: Helm" | nindent 4 }}
   {{- include "chart.engineLabels" . | nindent 4 }}
 spec:
   replicas: {{ $modelSpec.replicaCount }}
@@ -208,7 +208,9 @@
           - name: PYTHONHASHSEED
             value: "123"
           - name: HF_HOME
-            {{- if hasKey $modelSpec "pvcStorage" }}
+            {{- if and (hasKey $.Values "sharedPvcStorage") (ternary true $.Values.sharedPvcStorage.enabled (not (hasKey $.Values.sharedPvcStorage "enabled"))) }}
+            value: /data/shared-pvc-storage
+            {{- else if hasKey $modelSpec "pvcStorage" }}
             value: /data
             {{- else }}
             value: /tmp
@@ -415,7 +417,7 @@
           {{- if hasKey $modelSpec "extraVolumeMounts" }}
           {{- toYaml $modelSpec.extraVolumeMounts | nindent 10 }}
           {{- end }}
-          {{- if hasKey $.Values "sharedPvcStorage" }}
