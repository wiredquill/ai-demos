+      - fp8
+      - --reasoning-parser
+      - gemma4
+      - --enable-auto-tool-choice
+      - --tool-call-parser
+      - gemma4
+  auto:
+    requestGPU: 1
+    requestMemory: 32Gi
+    limitMemory: 80Gi
+    shmSize: 16Gi
+    vllmConfig:
+      maxModelLen: 131072
+      gpuMemoryUtilization: 0.9
+gemma-4-31b-it-fp8:
+  modelURL: RedHatAI/gemma-4-31B-it-FP8-dynamic
+  vllmConfig:
+    enableChunkedPrefill: true
+    enablePrefixCaching: true
+    extraArgs:
+      - --served-model-name
+      - gemma-4-31b
+      - --kv-cache-dtype
+      - fp8
+      - --reasoning-parser
+      - gemma4
+      - --enable-auto-tool-choice
+      - --tool-call-parser
+      - gemma4
+  auto:
+    requestGPU: 1
+    requestMemory: 32Gi
+    limitMemory: 64Gi
+    shmSize: 16Gi
+    vllmConfig:
+      maxModelLen: 65536
+      gpuMemoryUtilization: 0.9
+gemma-4-31b-it-nvfp4:
+  modelURL: nvidia/gemma-4-31B-it-NVFP4
+  vllmConfig:
