+# --- Embeddings (Hermes / Honcho memory) -----------------------------------------
+# dgx-spark-fleet honcho-embed: nomic-embed-text-v1, small context, ~8% of the GPU.
+nomic-embed-text-v1:
+  modelURL: nomic-ai/nomic-embed-text-v1
