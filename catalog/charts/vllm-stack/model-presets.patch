+    vllmConfig:
+      maxModelLen: 131072
+      gpuMemoryUtilization: 0.6
+# --- gpt-oss -------------------------------------------------------------------
+gpt-oss-20b:
+  modelURL: openai/gpt-oss-20b
+  vllmConfig:
+    enableChunkedPrefill: true
+    enablePrefixCaching: true
+    extraArgs:
+      - --served-model-name
+      - gpt-oss-20b
+      - --reasoning-parser
+      - openai_gptoss
+      - --enable-auto-tool-choice
+      - --tool-call-parser
+      - openai
+  auto:
+    requestGPU: 1
