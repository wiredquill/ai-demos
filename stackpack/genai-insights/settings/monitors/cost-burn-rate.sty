nodes:
- _type: Monitor
  name: Cost burn rate
  identifier: urn:stackpack:genai-insights:monitor:cost-burn-rate
  description: >-
    Estimated model spend in USD per hour, from gen_ai.client.operation.cost. Default budget 5 USD/h per model; edit the threshold per environment.
  intervalSeconds: 60
  status: ENABLED
  function: urn:stackpack:common:monitor-function:topological-threshold
  arguments:
    threshold: 5.0
    comparator: GT
    failureState: DEVIATING
    queries:
      topologyQuery: type = "genai model usage" and label = "stackpack:suse-ai"
      promqlQuery: >-
        sum(rate({__name__=~"gen_ai_client_operation_cost(_USD)?_sum", service_namespace="${tags.service.namespace}", service_name="${tags.service.name}", gen_ai_request_model="${tags.gen_ai.request.model}", gen_ai_provider_name="${tags.gen_ai.provider.name}", server_address=~"${tags.suse.ai.monitor.server_address}", server_port=~"${tags.suse.ai.monitor.server_port}"}[15m])) * 3600
      aliasTemplate: Spend (USD/h)
      unit: short
    titleTemplate: Cost burn rate
  remediationHint: !include 'remediation-hints/cost-burn-rate.md.hbs'
