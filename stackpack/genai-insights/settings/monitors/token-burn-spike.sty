nodes:
- _type: Monitor
  name: Token burn spike
  identifier: urn:stackpack:genai-insights:monitor:token-burn-spike
  description: >-
    Token throughput over 5m compared with the 1h average. A sustained multiple signals a runaway agent loop, prompt bloat or abusive traffic.
  intervalSeconds: 60
  status: ENABLED
  function: urn:stackpack:common:monitor-function:topological-threshold
  arguments:
    threshold: 3.0
    comparator: GT
    failureState: DEVIATING
    queries:
      topologyQuery: type = "genai model usage" and label = "stackpack:suse-ai"
      promqlQuery: >-
        sum(rate({__name__=~"gen_ai_client_token_usage(_tokens)?_sum", service_namespace="${tags.service.namespace}", service_name="${tags.service.name}", gen_ai_request_model="${tags.gen_ai.request.model}", gen_ai_provider_name="${tags.gen_ai.provider.name}", server_address=~"${tags.suse.ai.monitor.server_address}", server_port=~"${tags.suse.ai.monitor.server_port}"}[5m])) / sum(rate({__name__=~"gen_ai_client_token_usage(_tokens)?_sum", service_namespace="${tags.service.namespace}", service_name="${tags.service.name}", gen_ai_request_model="${tags.gen_ai.request.model}", gen_ai_provider_name="${tags.gen_ai.provider.name}", server_address=~"${tags.suse.ai.monitor.server_address}", server_port=~"${tags.suse.ai.monitor.server_port}"}[1h]))
      aliasTemplate: Token rate vs 1h average (x)
      unit: short
    titleTemplate: Token burn spike
  remediationHint: !include 'remediation-hints/token-burn-spike.md.hbs'
