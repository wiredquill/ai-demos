#!/bin/bash
# Run Hermes Agent as an OpenShell sandbox and forward its web terminal out of it.
#
#   1. register the in-cluster gateway with the CLI (mTLS bundle from a Secret)
#   2. delete the old sandbox unless it is being reused ($RECREATE=false)
#   3. (re)create the model provider: a custom provider profile that allows the
#      model's host and, with an API key, binds the key to that host (the sandbox
#      only ever sees a placeholder); then create the sandbox from
#      $SANDBOX_IMAGE under the profile's policy
#      With $RANCHER_URL and a token in $RANCHER_TOKEN_FILE, a second provider
#      binds that token to Rancher's host the same way, for the rancher CLI
#      and kubectl
#   3b. with cluster access ($CLUSTER_DIR holds a ServiceAccount token): write
#      a kubeconfig for $CLUSTER_SERVER to ~/.kube/config in the sandbox
#   4. forward 0.0.0.0:$FORWARD_PORT -> ttyd on 127.0.0.1:$TARGET_PORT inside the
#      sandbox, until the pod stops; then delete the sandbox.
#
# The pod is also the demo's CLI: `kubectl exec -it deploy/<release> -- openshell ...`
set -euo pipefail

: "${GATEWAY_ENDPOINT:=https://openshell:8080}"
: "${GATEWAY_NAME:=k8s}"
: "${TLS_DIR:=/etc/openshell/tls}"
: "${SANDBOX_NAME:=hermes-sandbox}"
: "${SANDBOX_IMAGE:?SANDBOX_IMAGE is required}"
: "${POLICY_FILE:=/etc/hermes/policy.yaml}"
: "${PROFILE:=research}"
: "${APPROVALS:=smart}"
: "${SANDBOX_GPU:=false}"
: "${RECREATE:=true}"
: "${DELETE_ON_EXIT:=true}"
: "${LLM_BASE_URL:?LLM_BASE_URL is required}"
: "${LLM_MODEL:?LLM_MODEL is required}"
: "${LLM_API_KEY_FILE:=/etc/hermes/llm/api-key}"
: "${PROVIDER_NAME:=$SANDBOX_NAME-llm}"
: "${TARGET_PORT:=7681}"
: "${FORWARD_PORT:=7681}"
: "${CLUSTER_DIR:=/etc/hermes/cluster}"
: "${CLUSTER_SERVER:=https://kubernetes.default.svc.cluster.local}"
: "${CLUSTER_NAME:=cluster}"
: "${RANCHER_URL:=}"
: "${RANCHER_TOKEN_FILE:=/etc/hermes/rancher/token}"
: "${RANCHER_ACCESS:=read-only}"
: "${RANCHER_PROVIDER:=$SANDBOX_NAME-rancher}"

# Executables in the Hermes image that call the model: the venv's python is a
# symlink, and OpenShell matches real paths.
LLM_BINARIES=(/usr/bin/python3.13 /usr/bin/curl)
KEY_ENV=HERMES_LLM_API_KEY
# What may call Rancher with its token: the CLI, and kubectl and helm, which
# reach downstream clusters through Rancher's /k8s/clusters/<id> proxy.
RANCHER_BINARIES=(/usr/local/bin/rancher /usr/local/bin/kubectl /usr/local/bin/helm)
RANCHER_KEY_ENV=RANCHER_CLI_TOKEN

log() { printf '%s hermes-client: %s\n' "$(date -u +%FT%TZ)" "$*"; }

# -- 1. gateway registration ------------------------------------------------------
# `gateway add --local` expects the client bundle to be in place already.
mtls="$HOME/.config/openshell/gateways/$GATEWAY_NAME/mtls"
mkdir -p "$mtls"
for f in ca.crt tls.crt tls.key; do cp "$TLS_DIR/$f" "$mtls/$f"; done
chmod 600 "$mtls/tls.key"
openshell gateway add "$GATEWAY_ENDPOINT" --local --name "$GATEWAY_NAME" >/dev/null 2>&1 || true
export OPENSHELL_GATEWAY=$GATEWAY_NAME

log "waiting for gateway $GATEWAY_ENDPOINT"
until openshell status >/dev/null 2>&1; do sleep 5; done
log "gateway connected"

# -- 2. old sandbox ----------------------------------------------------------------
# Delete it before touching the provider: a provider can't go while attached.
exists() { openshell sandbox get "$SANDBOX_NAME" >/dev/null 2>&1; }

if exists && [ "$RECREATE" = true ]; then
  log "deleting existing sandbox $SANDBOX_NAME (image, profile or model may have changed)"
  openshell sandbox delete "$SANDBOX_NAME" >/dev/null || true
  for _ in $(seq 60); do exists || break; sleep 2; done
fi

if exists; then
  log "reusing sandbox $SANDBOX_NAME and provider $PROVIDER_NAME"
else
  # -- 3. model provider, then the sandbox ---------------------------------------------
  # scheme://host[:port]/path -> host and port for the profile's endpoint
  url=${LLM_BASE_URL#*://}
  scheme=${LLM_BASE_URL%%://*}
  hostport=${url%%/*}
  llm_host=${hostport%%:*}
  if [ "$hostport" != "$llm_host" ]; then
    llm_port=${hostport##*:}
  elif [ "$scheme" = https ]; then
    llm_port=443
  else
    llm_port=80
  fi

  api_key=""
  [ -s "$LLM_API_KEY_FILE" ] && api_key=$(<"$LLM_API_KEY_FILE")

  profile_file=$HOME/llm-profile.yaml
  {
    echo "id: $PROVIDER_NAME"
    echo "display_name: Hermes model endpoint"
    echo "description: OpenAI-compatible endpoint for the $SANDBOX_NAME sandbox"
    echo "category: inference"
    echo "inference_capable: true"
    if [ -n "$api_key" ]; then
      echo "credentials:"
      echo "  - name: api_key"
      echo "    description: API key for $llm_host"
      echo "    env_vars: [$KEY_ENV]"
      echo "    required: true"
      echo "    auth_style: bearer"
      echo "    header_name: Authorization"
    fi
    echo "endpoints:"
    echo "  - host: $llm_host"
    echo "    port: $llm_port"
    echo "    protocol: rest"
    echo "    access: read-write"
    echo "    enforcement: enforce"
    echo "binaries:"
    for b in "${LLM_BINARIES[@]}"; do echo "  - $b"; done
  } > "$profile_file"

  log "provider $PROVIDER_NAME -> $llm_host:$llm_port${api_key:+ (API key bound to this host)}"
  # import has no --force, and lint rejects an id that is already registered:
  # remove the provider and its profile from an earlier run first
  openshell provider delete "$PROVIDER_NAME" >/dev/null 2>&1 || true
  openshell profile delete "$PROVIDER_NAME" >/dev/null 2>&1 || true
  openshell profile lint -f "$profile_file"
  openshell profile import -f "$profile_file"
  provider_args=(--name "$PROVIDER_NAME" --type "$PROVIDER_NAME")
  if [ -n "$api_key" ]; then
    # KEY alone = read from the environment, so the key isn't in the process arguments
    export "$KEY_ENV=$api_key"
    provider_args+=(--credential "$KEY_ENV")
  fi
  openshell provider create "${provider_args[@]}"
  unset "$KEY_ENV" api_key

  args=(--name "$SANDBOX_NAME" --from "$SANDBOX_IMAGE" --policy "$POLICY_FILE"
        --no-auto-providers --provider "$PROVIDER_NAME" --no-tty --detach
        --env "HERMES_BASE_URL=$LLM_BASE_URL"
        --env "HERMES_MODEL=$LLM_MODEL"
        --env "HERMES_APPROVALS=$APPROVALS"
        --env "TTYD_PORT=$TARGET_PORT")
  [ -s "$LLM_API_KEY_FILE" ] && args+=(--env "HERMES_KEY_ENV=$KEY_ENV")

  # Rancher: the token goes to the gateway only, bound to Rancher's host;
  # the sandbox's RANCHER_CLI_TOKEN is a placeholder the proxy swaps for it
  if [ -n "$RANCHER_URL" ] && [ -s "$RANCHER_TOKEN_FILE" ]; then
    rancher_host=${RANCHER_URL#https://}
    rancher_host=${rancher_host%%/*}
    rancher_port=443
    if [ "${rancher_host%:*}" != "$rancher_host" ]; then
      rancher_port=${rancher_host##*:}
      rancher_host=${rancher_host%:*}
    fi
    rancher_file=$HOME/rancher-profile.yaml
    {
      echo "id: $RANCHER_PROVIDER"
      echo "display_name: Rancher API"
      echo "description: Rancher's API for the $SANDBOX_NAME sandbox"
      echo "category: other"
      echo "credentials:"
      echo "  - name: token"
      echo "    description: Rancher API token for $rancher_host"
      echo "    env_vars: [$RANCHER_KEY_ENV]"
      echo "    required: true"
      echo "    auth_style: bearer"
      echo "    header_name: Authorization"
      echo "endpoints:"
      echo "  - host: $rancher_host"
      echo "    port: $rancher_port"
      echo "    protocol: rest"
      echo "    access: $RANCHER_ACCESS"
      echo "    enforcement: enforce"
      echo "binaries:"
      for b in "${RANCHER_BINARIES[@]}"; do echo "  - $b"; done
    } > "$rancher_file"
    log "provider $RANCHER_PROVIDER -> $rancher_host:$rancher_port ($RANCHER_ACCESS, token bound to this host)"
    openshell provider delete "$RANCHER_PROVIDER" >/dev/null 2>&1 || true
    openshell profile delete "$RANCHER_PROVIDER" >/dev/null 2>&1 || true
    openshell profile lint -f "$rancher_file"
    openshell profile import -f "$rancher_file"
    export "$RANCHER_KEY_ENV=$(<"$RANCHER_TOKEN_FILE")"
    openshell provider create --name "$RANCHER_PROVIDER" --type "$RANCHER_PROVIDER" --credential "$RANCHER_KEY_ENV"
    unset "$RANCHER_KEY_ENV"
    args+=(--provider "$RANCHER_PROVIDER" --env "RANCHER_CLI_URL=$RANCHER_URL")
    [ "$RANCHER_ACCESS" = read-only ] && args+=(--env RANCHER_CLI_READONLY=true)
  elif [ -n "$RANCHER_URL" ]; then
    log "no Rancher token in $RANCHER_TOKEN_FILE: the rancher CLI in the sandbox has no access"
  fi
  # The chart's Hermes options and OpenTelemetry go on to the sandbox by name:
  # skin, title, branding and cron job for hermes-sandbox-start; OTEL_* and
  # HERMES_OTEL_* for the image's sitecustomize.py. (Never every HERMES_*: the
  # API key passes through this environment.)
  for v in $(compgen -e); do
    case $v in
      OTEL_*|HERMES_OTEL_*|HERMES_SKIN|HERMES_TITLE|HERMES_BRANDING_*|HERMES_CRON_*|HERMES_PLATFORM_*)
        args+=(--env "$v=${!v}") ;;
    esac
  done
  [ -n "${OTEL_EXPORTER_OTLP_ENDPOINT:-}" ] && log "OpenTelemetry on: OTLP to $OTEL_EXPORTER_OTLP_ENDPOINT"
  [ -n "${HERMES_CRON_SCHEDULE:-}" ] && log "cron job ${HERMES_CRON_NAME:-token-traffic} on '$HERMES_CRON_SCHEDULE'"
  [ "$SANDBOX_GPU" = true ] && args+=(--gpu)
  log "creating sandbox $SANDBOX_NAME from $SANDBOX_IMAGE, profile $PROFILE (approvals: $APPROVALS)"
  openshell sandbox create "${args[@]}" -- hermes-sandbox-start
fi

# -- 3b. cluster access ----------------------------------------------------------------
# Written once the sandbox is up, and again into a reused one (the token may
# have changed); kubectl reads it per call, so Hermes starting first doesn't
# matter. Piped through `sandbox exec`, so the token never lands on this pod's
# disk (`sandbox upload` would also need ssh and git, which this image lacks).
# The policy's cluster-api rule passes this TLS through untouched (the
# supervisor doesn't trust the cluster CA), so kubectl checks the API server
# against ca.crt itself and the token has to be in the sandbox.
kubeconfig() {
  cat <<EOF
apiVersion: v1
kind: Config
clusters:
  - name: $CLUSTER_NAME
    cluster:
      server: $CLUSTER_SERVER
      certificate-authority-data: $(base64 -w0 < "$CLUSTER_DIR/ca.crt")
users:
  - name: hermes
    user:
      token: $(<"$CLUSTER_DIR/token")
contexts:
  - name: $CLUSTER_NAME
    context:
      cluster: $CLUSTER_NAME
      user: hermes
current-context: $CLUSTER_NAME
EOF
}
if [ -s "$CLUSTER_DIR/token" ]; then
  log "writing kubeconfig for $CLUSTER_SERVER (${HERMES_PLATFORM_ACCESS:-view} access)"
  written=false
  for _ in $(seq 60); do
    if kubeconfig | openshell sandbox exec "$SANDBOX_NAME" --no-tty --timeout 30 -- \
        sh -c 'umask 077 && mkdir -p /home/hermes/.kube && cat > /home/hermes/.kube/config' >/dev/null 2>&1; then
      written=true
      break
    fi
    sleep 3
  done
  $written || log "could not write the kubeconfig; kubectl in the sandbox has no cluster"
fi

# -- 4. forward until stopped ---------------------------------------------------------
fwd=""
shutdown() {
  [ -n "$fwd" ] && kill "$fwd" 2>/dev/null
  if [ "$DELETE_ON_EXIT" = true ]; then
    log "deleting sandbox $SANDBOX_NAME"
    openshell sandbox delete "$SANDBOX_NAME" >/dev/null 2>&1 || true
  fi
  exit 0
}
trap shutdown TERM INT

log "forwarding 0.0.0.0:$FORWARD_PORT -> $SANDBOX_NAME:$TARGET_PORT"
while true; do
  # fails while the sandbox is still starting; retry until ttyd answers
  openshell forward service --target-port "$TARGET_PORT" --local "0.0.0.0:$FORWARD_PORT" "$SANDBOX_NAME" &
  fwd=$!
  wait "$fwd" || true
  fwd=""
  log "forward exited; retrying in 3s"
  sleep 3
done
