#!/bin/bash
# Sandbox entrypoint: write Hermes's config from the environment the client pod
# passes to `openshell sandbox create --env`, then serve `hermes` in a browser
# terminal on 127.0.0.1 (the sandbox has no inbound network; the client pod
# forwards this port out through the gateway).
#
#   HERMES_BASE_URL   OpenAI-compatible endpoint, e.g. http://vllm-router-service/v1
#   HERMES_MODEL      model name sent in each request
#   HERMES_KEY_ENV    name of the env var holding the API key ("" = no key). With an
#                     OpenShell provider it holds a placeholder; the gateway's proxy
#                     swaps in the real key for the model's host only.
#   HERMES_APPROVALS  manual | smart | off (the profile picks it)
#   TTYD_PORT         default 7681
#   HERMES_TITLE      the browser tab's title (the chart adds the profile)
#   HERMES_SKIN       display skin: a built-in (mono, slate, poseidon, ...) or
#                     one shipped in /opt/hermes/skins
#   HERMES_BRANDING_<KEY>  override that skin's branding text, KEY one of
#                     AGENT_NAME WELCOME GOODBYE RESPONSE_LABEL PROMPT_SYMBOL HELP_HEADER
#   HERMES_CRON_SCHEDULE, HERMES_CRON_PROMPT, HERMES_CRON_NAME
#                     a Hermes cron job created at start, with a scheduler tick
#                     once a minute (cron jobs only fire while something ticks)
#   OTEL_*, HERMES_OTEL_*  OpenTelemetry for the model calls; read at Python
#                     startup by /opt/hermes/.../sitecustomize.py, not here
#   HERMES_PLATFORM_ACCESS, HERMES_PLATFORM_VIA, HERMES_PLATFORM_CLUSTER,
#   HERMES_PLATFORM_RANCHER
#                     cluster access for platform engineers: view | operator,
#                     kubernetes | rancher, the cluster's name (kubernetes: the
#                     client uploads ~/.kube/config) or Rancher's URL (rancher:
#                     the CLI reads RANCHER_CLI_URL and RANCHER_CLI_TOKEN). This
#                     only tells Hermes about it (workspace AGENTS.md)
set -euo pipefail

: "${HERMES_BASE_URL:?HERMES_BASE_URL is required}"
: "${HERMES_MODEL:?HERMES_MODEL is required}"
: "${HERMES_KEY_ENV:=}"
: "${HERMES_APPROVALS:=smart}"
: "${TTYD_PORT:=7681}"
: "${HERMES_TITLE:=Hermes in OpenShell}"
: "${HERMES_SKIN:=default}"
: "${HERMES_CRON_SCHEDULE:=}"
: "${HERMES_CRON_PROMPT:=}"
: "${HERMES_CRON_NAME:=token-traffic}"
: "${HERMES_PLATFORM_ACCESS:=}"
: "${HERMES_PLATFORM_CLUSTER:=this cluster}"
: "${HERMES_PLATFORM_VIA:=kubernetes}"
: "${HERMES_PLATFORM_RANCHER:=}"

# OpenShell sets HOME=/sandbox; the profiles only let the agent write under
# /home/hermes and /tmp, so put Hermes's state (~/.hermes) there
export HOME=/home/hermes

mkdir -p "$HOME/.hermes" "$HOME/workspace"
config=$HOME/.hermes/config.yaml
# Keep a config the user changed inside the sandbox (hermes model, hermes config
# set); the client recreates the sandbox when the form changes anyway.
if [ ! -s "$config" ]; then
  {
    echo "model:"
    echo "  provider: custom"
    echo "  base_url: \"$HERMES_BASE_URL\""
    echo "  default: \"$HERMES_MODEL\""
    if [ -n "$HERMES_KEY_ENV" ]; then
      echo "  key_env: $HERMES_KEY_ENV"
    fi
    echo "terminal:"
    # the sandbox is the isolation: run the agent's commands in it directly
    echo "  backend: local"
    echo "  cwd: \"$HOME/workspace\""
    echo "approvals:"
    echo "  mode: $HERMES_APPROVALS"
    echo "display:"
    echo "  skin: $HERMES_SKIN"
  } > "$config"
fi

# Skins shipped in the image, then the chosen skin with the form's branding.
# A user skin of the same name replaces a built-in, but its missing keys fall
# back to "default", not to that built-in: so copy the whole skin and change
# only the branding. Run without OTEL_*: no telemetry for this helper.
mkdir -p "$HOME/.hermes/skins"
for f in /opt/hermes/skins/*.yaml; do
  [ -e "$f" ] && cp "$f" "$HOME/.hermes/skins/"
done

# Skills shipped in an image built on this one (hermes-rancher: the rancher
# CLI's skill); the image's copy wins, so it matches the binary.
mkdir -p "$HOME/.hermes/skills"
for d in /opt/hermes/skills/*/; do
  [ -e "$d" ] && cp -r "$d" "$HOME/.hermes/skills/"
done
if compgen -e | grep -q '^HERMES_BRANDING_'; then
  env -u OTEL_EXPORTER_OTLP_ENDPOINT /opt/hermes/bin/python - <<'PY'
import copy
import os
from pathlib import Path

import yaml
from hermes_cli.skin_engine import _BUILTIN_SKINS

name = os.environ["HERMES_SKIN"]
path = Path.home() / ".hermes" / "skins" / f"{name}.yaml"
if path.is_file():
    skin = yaml.safe_load(path.read_text(encoding="utf-8"))
else:
    skin = copy.deepcopy(_BUILTIN_SKINS.get(name) or _BUILTIN_SKINS["default"])
skin["name"] = name
branding = skin.setdefault("branding", {})
for key in ("agent_name", "welcome", "goodbye", "response_label",
            "prompt_symbol", "help_header"):
    value = os.environ.get(f"HERMES_BRANDING_{key.upper()}")
    if value:
        branding[key] = value
path.write_text(yaml.safe_dump(skin, allow_unicode=True, sort_keys=False),
                encoding="utf-8")
PY
fi

cd "$HOME/workspace"

# Cluster access: Hermes reads AGENTS.md from its working directory into the
# system prompt, so it knows kubectl works and what it may do. Kept if the
# user changed it in a reused sandbox.
if [ -n "$HERMES_PLATFORM_ACCESS" ] && [ ! -e AGENTS.md ] && [ "$HERMES_PLATFORM_VIA" = rancher ]; then
  case $HERMES_PLATFORM_ACCESS in
    operator) can="Its Rancher token may change what its Rancher roles allow. Use the CLI's safety loop: \`--dry-run\` first, show the plan, \`--apply\` only after a yes." ;;
    *) can="This is read-only: the CLI is in read-only mode and the sandbox only lets reads through to Rancher." ;;
  esac
  # kubectl contexts, one per cluster (images/hermes-rancher); the sandbox's
  # network may take a moment after start
  clusters=""
  if command -v rancher-kubeconfig >/dev/null; then
    for _ in 1 2 3 4 5; do
      clusters=$(rancher-kubeconfig 2>/tmp/rancher-kubeconfig.log) && break
      sleep 3
    done
  fi
  if [ -n "$clusters" ]; then
    known=$(printf -- '- %s (id %s)\n' $clusters)
  else
    known="- none found: run \`rancher-kubeconfig\` (log in /tmp/rancher-kubeconfig.log)"
  fi
  extra=", rancher"
  cat > AGENTS.md <<EOF
# Platform engineering assistant

You help platform engineers run the Kubernetes clusters that the Rancher at
$HERMES_PLATFORM_RANCHER manages.
The \`rancher\` CLI in the terminal is already logged in (RANCHER_CLI_URL,
RANCHER_CLI_TOKEN): don't run \`rancher auth login\`. Follow your \`rancher\`
skill for how to use it. $can

Clusters you can reach:
$known

- Name the cluster on every command (\`rancher ... --cluster <name>\`,
  \`kubectl --context <name>\`) and say which one you looked at.
  (\`rancher get clusters\` may be refused: it needs access to Rancher's own
  local cluster. The list above comes from \`rancher-kubeconfig\`.)
- Investigate before answering: \`rancher inspect\`, \`rancher usage\`,
  \`rancher logs\`, \`rancher access\`, \`rancher get <type>\`, and kubectl.
- kubectl is already configured: one context per cluster above, through
  Rancher with the same token. Don't run \`rancher kubeconfig\`: it mints new
  tokens.
- Tools here: kubectl, helm, jq, yq, awk, python3, curl, git, openssl$extra.
  Nothing can be installed (no root, no package repositories). kubectl
  \`-o jsonpath\`/\`custom-columns\` and \`rancher -o template=...\` often need no
  parser at all. helm reads releases from Secrets, so \`helm list\` needs Secret
  access.
- Before any change, say what you will run and why, and wait for a yes.
- A "forbidden" or AUTH error is the access you were given, not a fault: say
  so and give the command a platform engineer could run instead.
EOF
elif [ -n "$HERMES_PLATFORM_ACCESS" ] && [ ! -e AGENTS.md ]; then
  case $HERMES_PLATFORM_ACCESS in
    operator) can="read everything except Secrets, restart and scale Deployments, StatefulSets and DaemonSets, and delete Pods so their controller replaces them" ;;
    *) can="read everything except Secrets; it can't change anything" ;;
  esac
  extra=""
  cat > AGENTS.md <<EOF
# Platform engineering assistant

You help platform engineers run the Kubernetes cluster "$HERMES_PLATFORM_CLUSTER".
\`kubectl\` in the terminal is already configured for it (~/.kube/config).
Its ServiceAccount can $can.

- Investigate before answering: \`kubectl get\`, \`describe\`, \`logs\`,
  \`get events --sort-by=.lastTimestamp\`, \`top\` if metrics-server is there.
- Use \`-A\` or \`-n <namespace>\` explicitly; say which namespace you looked at.
- Tools here: kubectl, helm, jq, yq, awk, python3, curl, git, openssl$extra.
  Nothing can be installed (no root, no package repositories). kubectl
  \`-o jsonpath\`/\`custom-columns\` and \`rancher -o template=...\` often need no
  parser at all. helm reads releases from Secrets, so \`helm list\` needs Secret
  access.
- Before any change, say what you will run and why, and wait for a yes.
- A "forbidden" error is the access you were given, not a fault: say so and
  give the command a platform engineer could run instead.
EOF
fi

# The cron job, once (a reused sandbox keeps it), and its scheduler: a tick
# just after each minute starts. Each run is a full agent turn, so it shows up
# in OpenTelemetry like a chat does.
if [ -n "$HERMES_CRON_SCHEDULE" ] && [ -n "$HERMES_CRON_PROMPT" ]; then
  if ! hermes cron list 2>/dev/null | grep -Eq "Name:[[:space:]]+$HERMES_CRON_NAME\$"; then
    hermes cron create "$HERMES_CRON_SCHEDULE" "$HERMES_CRON_PROMPT" \
      --name "$HERMES_CRON_NAME" --deliver local >/dev/null \
      || echo "hermes-sandbox-start: could not create cron job $HERMES_CRON_NAME" >&2
  fi
  (
    while true; do
      sleep $((62 - $(date +%s) % 60)) & wait $!
      hermes cron tick >/dev/null 2>&1 || true
    done
  ) &
fi

# Keep ttyd up: it is the sandbox's main process, and if it exits OpenShell
# marks the sandbox Error and the client's forward stops. Restart it instead,
# backing off while it keeps failing; pass TERM/INT on when the sandbox stops.
ttyd_pid=""
stop() { [ -n "$ttyd_pid" ] && kill "$ttyd_pid" 2>/dev/null; exit 0; }
trap stop TERM INT

delay=1
while true; do
  started=$SECONDS
  # -W: writable (people type into it); each browser tab gets its own hermes session
  ttyd -i 127.0.0.1 -p "$TTYD_PORT" -W -t titleFixed="$HERMES_TITLE" hermes &
  ttyd_pid=$!
  status=0
  wait "$ttyd_pid" || status=$?
  ttyd_pid=""
  # a run that lasted a minute was healthy: start the backoff over
  [ $((SECONDS - started)) -ge 60 ] && delay=1
  echo "hermes-sandbox-start: ttyd exited (status $status); restarting in ${delay}s" >&2
  # in the background so TERM interrupts the backoff instead of waiting it out
  sleep "$delay" & wait $!
  [ "$delay" -lt 30 ] && delay=$((delay * 2))
done
