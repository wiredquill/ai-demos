#!/bin/bash
# Write ~/.kube/config with one context per cluster Rancher lets this
# sandbox's token see, each through Rancher's /k8s/clusters/<id> proxy, and
# print "<name> <id>" for each.
#
# The token in it is the OpenShell placeholder from RANCHER_CLI_TOKEN: the
# gateway swaps in the real token on requests to Rancher, so the file holds
# nothing secret. Not `rancher kubeconfig`: its exec plugin mints a token per
# cluster (a POST a read-only sandbox may not make). Not `rancher get
# clusters`: that reads through Rancher's local cluster, which a user without
# access to it is refused; Rancher's /v1 API lists the clusters any user is a
# member of.
set -euo pipefail
: "${RANCHER_CLI_URL:?RANCHER_CLI_URL is required}"
: "${RANCHER_CLI_TOKEN:?RANCHER_CLI_TOKEN is required}"

clusters=$(kubectl --server "$RANCHER_CLI_URL" --token "$RANCHER_CLI_TOKEN" \
    get --raw /v1/management.cattle.io.clusters |
  /opt/hermes/bin/python -c '
import json, sys
for c in json.load(sys.stdin)["data"]:
    name = (c.get("spec", {}).get("displayName") or c["id"]).replace(" ", "-")
    print(name, c["id"])
')

mkdir -p "$HOME/.kube"
kubectl config set-credentials rancher --token="$RANCHER_CLI_TOKEN" >/dev/null
while read -r name id; do
  [ -n "$id" ] || continue
  kubectl config set-cluster "$name" --server="$RANCHER_CLI_URL/k8s/clusters/$id" >/dev/null
  kubectl config set-context "$name" --cluster "$name" --user rancher >/dev/null
  echo "$name $id"
done <<<"$clusters"
